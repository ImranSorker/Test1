# --- sandbox-service configuration (copy to .env and adjust) ---
# All settings are read from environment variables prefixed with SANDBOX_.

# Adapter selection: local | docker | fake
SANDBOX_DEFAULT_BACKEND=local

# Where per-execution workspace directories are created.
# Leave empty to use the system temp directory.
SANDBOX_WORKSPACE_ROOT=/tmp/sandbox-workspaces

# Default execution limits (can be overridden per request, bounded by *_MAX below).
SANDBOX_DEFAULT_TIMEOUT_S=10
SANDBOX_DEFAULT_MEMORY_MB=512
SANDBOX_MAX_OUTPUT_BYTES=65536

# Hard upper bounds enforced on any client-supplied limit.
SANDBOX_MAX_TIMEOUT_S=120
SANDBOX_MAX_MEMORY_MB=4096
SANDBOX_MAX_CPU_SECONDS=120
SANDBOX_MAX_FILE_SIZE_MB=64
SANDBOX_MAX_PROCESSES=128

# Language allowlist (comma-separated): python,bash,node,...
SANDBOX_ALLOWED_LANGUAGES=python,bash

# Local adapter interpreter paths (empty = auto-detect via shutil.which).
SANDBOX_PYTHON_BINARY=
SANDBOX_BASH_BINARY=

# Docker adapter (SANDBOX_DEFAULT_BACKEND=docker)
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_DOCKER_CLI_PATH=docker
SANDBOX_DOCKER_CONTAINER_PREFIX=sbsvc

# HTTP API server (sandbox serve)
SANDBOX_API_HOST=127.0.0.1
SANDBOX_API_PORT=8090
# Bearer token required on all non-/healthz routes when set (empty = no auth).
SANDBOX_API_AUTH_TOKEN=

# Resilience for remote backends (docker / http)
SANDBOX_RETRY_MAX_ATTEMPTS=3
SANDBOX_RETRY_BASE_DELAY_S=0.2
SANDBOX_RETRY_MAX_DELAY_S=5.0
SANDBOX_CIRCUIT_FAILURE_THRESHOLD=5
SANDBOX_CIRCUIT_RECOVERY_TIMEOUT_S=30.0

# Remote HTTP backend adapter (SANDBOX_DEFAULT_BACKEND=http style deployments)
SANDBOX_REMOTE_BASE_URL=
SANDBOX_REMOTE_API_KEY=
SANDBOX_REMOTE_REQUEST_TIMEOUT_S=120

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
SANDBOX_LOG_LEVEL=INFO
